[Unit]
Description=minerU PDF parsing Router (multi-GPU CUDA)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER

# Environment
Environment=MINERU_ROUTER_HOST=0.0.0.0
Environment=MINERU_ROUTER_PORT=8002
Environment=MINERU_API_MAX_CONCURRENT_REQUESTS=2
Environment=MINERU_API_OUTPUT_ROOT=/mnt/shared/mineru_api_output
Environment=MINERU_API_ENABLE_FASTAPI_DOCS=0
Environment=CUDA_VISIBLE_DEVICES=0
Environment=MINERU_ROUTER_LOCAL_GPUS=0

# ExecStart
ExecStart=/home/YOUR_USER/mineru_wrapper/deploy_router.sh

# Restart
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
ProtectHome=read-only
ReadWritePaths=/mnt/shared/mineru_api_output /mnt/shared/mineru_logs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
