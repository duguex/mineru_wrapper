[Unit]
Description=minerU PDF parsing Router (multi-GPU CUDA)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER

# deploy.sh router auto-detects GPUs; on a single-GPU host that resolves to 0.
# Pin explicitly via Environment=MINERU_ROUTER_LOCAL_GPUS=0,1 when needed.
ExecStart=/home/YOUR_USER/mineru_wrapper/deploy.sh router

# Restart
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
ProtectHome=read-only
ReadWritePaths=/mnt/shared/mineru_api_output /mnt/shared/mineru_logs
PrivateTmp=true

[Install]
WantedBy=multi-user.target