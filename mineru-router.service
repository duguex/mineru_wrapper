[Unit]
Description=minerU PDF parsing Router (multi-GPU ROCm)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER

# Environment
Environment=MINERU_ROUTER_HOST=0.0.0.0
Environment=MINERU_ROUTER_PORT=8002
Environment=MINERU_API_MAX_CONCURRENT_REQUESTS=2
Environment=MINERU_API_OUTPUT_ROOT=/mnt/shared/mineru_api_output
Environment=MINERU_API_ENABLE_FASTAPI_DOCS=0
Environment=HIP_VISIBLE_DEVICES=0,1
Environment=ROCM_HOME=/opt/rocm-7.2.1
Environment=ROCBLAS_TENSILE_LIBPATH=/opt/rocm-7.2.1/lib/rocblas/library/
Environment=LD_LIBRARY_PATH=/opt/rocm-7.2.1/lib

# ExecStart
ExecStart=/home/YOUR_USER/mineru_wrapper/deploy_router.sh

# Restart
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
ProtectHome=read-only
ReadWritePaths=/mnt/shared/mineru_api_output /mnt/shared/mineru_logs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
