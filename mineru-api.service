[Unit]
Description=minerU PDF parsing API server (CUDA)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER

# Environment
Environment=MINERU_API_HOST=0.0.0.0
Environment=MINERU_API_PORT=8001
Environment=MINERU_API_MAX_CONCURRENT_REQUESTS=2
Environment=MINERU_API_OUTPUT_ROOT=/mnt/shared/mineru_api_output
Environment=MINERU_API_ENABLE_FASTAPI_DOCS=1
Environment=CUDA_VISIBLE_DEVICES=0

# ExecStart — use the wrapper script to ensure env is correct
ExecStart=/home/YOUR_USER/mineru_wrapper/deploy_api.sh

# Restart
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
ProtectHome=read-only
ReadWritePaths=/mnt/shared/mineru_api_output /mnt/shared/mineru_logs
PrivateTmp=true

[Install]
WantedBy=multi-user.target
