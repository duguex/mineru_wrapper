[Unit]
Description=minerU PDF parsing API server (CUDA)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER

# All runtime values (host, port, GPU, docs, output root, log dir) default
# inside deploy.sh; override via Environment=MINERU_* as needed.
ExecStart=/home/YOUR_USER/mineru_wrapper/deploy.sh api

# Restart
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal

# Security
NoNewPrivileges=true
ProtectHome=read-only
ReadWritePaths=/mnt/shared/mineru_api_output /mnt/shared/mineru_logs
PrivateTmp=true

[Install]
WantedBy=multi-user.target